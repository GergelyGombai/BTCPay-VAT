@using BTCPayServer.Client
@model BTCPayServer.Components.MainNav.MainNavViewModel
@{
    var store = Context.GetStoreData();
}

@if (store != null)
{
    <li class="nav-item" permission="@Policies.CanModifyStoreSettings">
        <a layout-menu-item="VAT" asp-area="" asp-controller="UIStoreVAT" asp-action="Index" asp-route-storeId="@store.Id">
            <svg role="img" class="icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="8.5" cy="8.5" r="2.75" stroke="currentColor" stroke-width="1.5"/><circle cx="15.5" cy="15.5" r="2.75" stroke="currentColor" stroke-width="1.5"/><path d="M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            <span>VAT</span>
        </a>
    </li>
}
