@model VATSettingsViewModel
@{
    ViewData["Title"] = "VAT Settings";
    Layout = "_LayoutSimple";
}

<div class="sticky-header">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="UIStores" asp-action="Dashboard" asp-route-storeId="@Model.StoreId">Dashboard</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">VAT Settings</li>
        </ol>
    </nav>
    <h2>@ViewData["Title"]</h2>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-xxl-constrain">
        <form asp-action="Settings" asp-route-storeId="@Model.StoreId" method="post">
            <div class="form-group">
                <div class="form-check">
                    <input asp-for="Enabled" type="checkbox" class="form-check-input" />
                    <label asp-for="Enabled" class="form-check-label">Enable VAT calculation</label>
                </div>
                <span class="text-muted small">When enabled, VAT will be calculated and added to invoices created via the VAT API endpoints.</span>
            </div>

            <div class="form-group mt-4">
                <label asp-for="Mode" class="form-label">VAT Mode</label>
                <select asp-for="Mode" class="form-select">
                    <option value="@VATMode.Fixed">Fixed - Single country VAT rate</option>
                    <option value="@VATMode.OSS">OSS - Customer location-based VAT (One-Stop Shop)</option>
                </select>
                <span class="text-muted small">
                    <strong>Fixed:</strong> Always charges your home country's VAT rate.<br />
                    <strong>OSS:</strong> Charges VAT based on the customer's EU country (for B2C EU sales above €10,000/year).
                </span>
            </div>

            <div class="form-group mt-4">
                <label asp-for="HomeCountry" class="form-label">Home Country</label>
                <select asp-for="HomeCountry" class="form-select">
                    @foreach (var country in Model.EUCountries)
                    {
                        <option value="@country.Code">@country.Name (@country.Code) - @country.StandardRate%</option>
                    }
                </select>
                <span class="text-muted small">Your business registration country. In Fixed mode, this rate will be applied to all invoices.</span>
            </div>

            <div class="form-group mt-4">
                <label asp-for="VATNumber" class="form-label">VAT Registration Number</label>
                <input asp-for="VATNumber" class="form-control" placeholder="e.g., DE123456789" />
                <span class="text-muted small">Your business VAT identification number. This will be included in invoice metadata.</span>
            </div>

            <div class="form-group mt-4">
                <div class="form-check">
                    <input asp-for="ValidateVIES" type="checkbox" class="form-check-input" />
                    <label asp-for="ValidateVIES" class="form-check-label">Validate B2B VAT numbers via VIES</label>
                </div>
                <span class="text-muted small">
                    When enabled, customer VAT numbers will be validated against the EU VIES system.
                    Valid B2B transactions to other EU countries will have reverse charge applied (0% VAT).
                </span>
            </div>

            <div class="form-group mt-4">
                <div class="form-check">
                    <input asp-for="BelowSmallBusinessThreshold" type="checkbox" class="form-check-input" />
                    <label asp-for="BelowSmallBusinessThreshold" class="form-check-label">Below small business threshold (Kleinunternehmerregelung)</label>
                </div>
                <span class="text-muted small">
                    If your business is below the small business threshold in your country, no VAT will be charged.
                    Note: Thresholds vary by country (e.g., €22,000/year in Germany).
                </span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Save Settings</button>
                <a asp-action="Reports" asp-route-storeId="@Model.StoreId" class="btn btn-secondary ms-2">View Reports</a>
            </div>
        </form>
    </div>
</div>

<div class="row mt-5">
    <div class="col-xxl-constrain">
        <h3>API Endpoints</h3>
        <p class="text-muted">Use these endpoints to create invoices with automatic VAT calculation:</p>
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Method</th>
                    <th>Endpoint</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><code>POST</code></td>
                    <td><code>/api/v1/stores/{storeId}/vat/calculate</code></td>
                    <td>Preview VAT calculation</td>
                </tr>
                <tr>
                    <td><code>POST</code></td>
                    <td><code>/api/v1/stores/{storeId}/vat/invoices</code></td>
                    <td>Create invoice with VAT</td>
                </tr>
                <tr>
                    <td><code>GET</code></td>
                    <td><code>/api/v1/stores/{storeId}/vat/reports</code></td>
                    <td>Generate VAT report</td>
                </tr>
                <tr>
                    <td><code>GET</code></td>
                    <td><code>/api/v1/vat/rates</code></td>
                    <td>Get all EU VAT rates</td>
                </tr>
                <tr>
                    <td><code>GET</code></td>
                    <td><code>/api/v1/vat/validate/{vatNumber}</code></td>
                    <td>Validate VAT number via VIES</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
