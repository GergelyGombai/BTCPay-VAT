@model VATReportsViewModel
@{
    ViewData["Title"] = "VAT Reports";
    Layout = "_LayoutSimple";
}

<div class="sticky-header">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="UIStores" asp-action="Dashboard" asp-route-storeId="@Model.StoreId">Dashboard</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-action="Settings" asp-route-storeId="@Model.StoreId">VAT Settings</a>
            </li>
            <li class="breadcrumb-item active" aria-current="page">Reports</li>
        </ol>
    </nav>
    <h2>@ViewData["Title"]</h2>
</div>

<div class="row">
    <div class="col-12">
        <form method="get" class="mb-4">
            <div class="row g-3 align-items-end">
                <div class="col-auto">
                    <label class="form-label">Start Date</label>
                    <input type="date" name="startDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-auto">
                    <label class="form-label">End Date</label>
                    <input type="date" name="endDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-auto">
                    <label class="form-label">Group By</label>
                    <select name="grouping" class="form-select">
                        <option value="@VATReportGrouping.ByCountry" selected="@(Model.Grouping == VATReportGrouping.ByCountry)">Country</option>
                        <option value="@VATReportGrouping.ByMonth" selected="@(Model.Grouping == VATReportGrouping.ByMonth)">Month</option>
                        <option value="@VATReportGrouping.ByQuarter" selected="@(Model.Grouping == VATReportGrouping.ByQuarter)">Quarter</option>
                        <option value="@VATReportGrouping.ByRate" selected="@(Model.Grouping == VATReportGrouping.ByRate)">VAT Rate</option>
                    </select>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">Generate Report</button>
                </div>
                <div class="col-auto">
                    <a asp-action="ExportReport"
                       asp-route-storeId="@Model.StoreId"
                       asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")"
                       asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")"
                       asp-route-grouping="@Model.Grouping"
                       class="btn btn-secondary">
                        Export CSV
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Summary</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="text-muted small">Total Invoices</div>
                        <div class="fs-4 fw-bold">@Model.Report.InvoiceCount</div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small">Total Net Amount</div>
                        <div class="fs-4 fw-bold">@Model.Report.TotalNetAmount.ToString("N2")</div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small">Total VAT Amount</div>
                        <div class="fs-4 fw-bold text-primary">@Model.Report.TotalVATAmount.ToString("N2")</div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small">Total Gross Amount</div>
                        <div class="fs-4 fw-bold">@Model.Report.TotalGrossAmount.ToString("N2")</div>
                    </div>
                </div>
                @if (Model.Report.ReverseChargeCount > 0)
                {
                    <div class="row mt-3">
                        <div class="col-12">
                            <div class="alert alert-info mb-0">
                                <strong>Reverse Charge Transactions:</strong> @Model.Report.ReverseChargeCount invoices
                                (Net: @Model.Report.ReverseChargeTotalNet.ToString("N2"))
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Detail by @Model.Grouping.ToString().Replace("By", "")</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.Report.Items.Any())
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>@Model.Grouping.ToString().Replace("By", "")</th>
                                @if (Model.Grouping == VATReportGrouping.ByCountry)
                                {
                                    <th>Code</th>
                                }
                                <th class="text-end">Invoices</th>
                                <th class="text-end">Net Amount</th>
                                <th class="text-end">VAT Amount</th>
                                <th class="text-end">Gross Amount</th>
                                <th class="text-end">Avg Rate</th>
                                <th class="text-end">Reverse Charge</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Report.Items)
                            {
                                <tr>
                                    <td>@item.GroupLabel</td>
                                    @if (Model.Grouping == VATReportGrouping.ByCountry)
                                    {
                                        <td><code>@item.CountryCode</code></td>
                                    }
                                    <td class="text-end">@item.InvoiceCount</td>
                                    <td class="text-end">@item.NetAmount.ToString("N2")</td>
                                    <td class="text-end text-primary fw-bold">@item.VATAmount.ToString("N2")</td>
                                    <td class="text-end">@item.GrossAmount.ToString("N2")</td>
                                    <td class="text-end">@item.AverageVATRate.ToString("N1")%</td>
                                    <td class="text-end">@item.ReverseChargeCount</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr class="fw-bold">
                                <td>Total</td>
                                @if (Model.Grouping == VATReportGrouping.ByCountry)
                                {
                                    <td></td>
                                }
                                <td class="text-end">@Model.Report.InvoiceCount</td>
                                <td class="text-end">@Model.Report.TotalNetAmount.ToString("N2")</td>
                                <td class="text-end text-primary">@Model.Report.TotalVATAmount.ToString("N2")</td>
                                <td class="text-end">@Model.Report.TotalGrossAmount.ToString("N2")</td>
                                <td class="text-end">-</td>
                                <td class="text-end">@Model.Report.ReverseChargeCount</td>
                            </tr>
                        </tfoot>
                    </table>
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        No VAT transactions found for the selected period.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
